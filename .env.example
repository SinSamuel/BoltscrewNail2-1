# Copy to .env.local and fill in. Never commit .env.local.

# Stripe — Dashboard > Developers > API keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe — Dashboard > Developers > Webhooks > endpoint /api/webhook
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Sales tax (Stripe Tax can't be used until the account is activated).
# Defaults in code: 7% flat NC tax at 101 Main St, Angier, NC 27501.
#TAX_PERCENT=7
#TAX_LOCATION=101 Main St, Angier, NC 27501
# Once Stripe Tax is activated, set =true (and configure the head office
# address in Stripe Settings > Tax) to swap manual tax for automatic tax.
#STRIPE_TAX=false

# Google Analytics 4 — Web stream > Measurement ID
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
